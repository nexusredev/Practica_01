package practica01_arraylist;

import java.io.File;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Scanner;

public class GestorPedidos {
    private ArrayList<Pedido> historialPedidos;
    private File archivoVentas;

    public GestorPedidos() {
        this.historialPedidos = new ArrayList<>();
        this.archivoVentas = new File("ventas.txt");
    }

    public int obtenerSiguienteId() {
        return historialPedidos.size() + 1;
    }

    public void registrarVenta(Pedido pedido) {
        historialPedidos.add(pedido);
        guardarVentas();
    }

    public void generarReporte() {
        System.out.println("\n========== REPORTE DIARIO DE VENTAS ==========");
        if (historialPedidos.isEmpty()) {
            System.out.println("No hay ventas registradas.");
            return;
        }

        double totalAcumulado = 0.0;
        var conteoProductos = new HashMap<String, Integer>();

        for (var pedido : historialPedidos) {
            totalAcumulado += pedido.calcularTotal();
            var prods = pedido.getProductos();
            var cants = pedido.getCantidades();
            for (int i = 0; i < prods.size(); i++) {
                var nombre = prods.get(i).getNombre();
                conteoProductos.put(nombre, conteoProductos.getOrDefault(nombre, 0) + cants.get(i));
            }
        }

        System.out.printf("Total Vendido en el Día: $%.2f%n", totalAcumulado);
        System.out.println("\n--- Productos Más Vendidos ---");
        conteoProductos.entrySet().stream()
                .sorted((e1, e2) -> e2.getValue().compareTo(e1.getValue()))
                .forEach(entry -> System.out.printf("- %s: %d unidades%n", entry.getKey(), entry.getValue()));
        System.out.println("===============================================");
    }

    public void cargarVentas(GestorProductos gestorProductos) {
        historialPedidos.clear();
        try {
            if (!archivoVentas.exists()) {
                archivoVentas.createNewFile();
                return;
            }
            try (var scanner = new Scanner(archivoVentas)) {
                Pedido pedidoActual = null;
                while (scanner.hasNextLine()) {
                    var linea = scanner.nextLine().trim();
                    if (linea.isEmpty()) continue;

                    var datos = linea.split("\\|");
                    if (datos[0].equals("#PEDIDO")) {
                        int id = Integer.parseInt(datos[1]);
                        pedidoActual = new Pedido(id);
                        historialPedidos.add(pedidoActual);
                    } else if (datos[0].equals("#ITEM") && pedidoActual != null) {
                        var idProd = datos[1];
                        int cantidad = Integer.parseInt(datos[2]);
                        var producto = gestorProductos.buscarPorId(idProd);
                        if (producto != null) {
                            pedidoActual.agregarProducto(producto, cantidad);
                        }
                    }
                }
            }
        } catch (IOException | NumberFormatException e) {
            System.err.println("Error al cargar historial de ventas: " + e.getMessage());
        }
    }

    public void guardarVentas() {
        try (var pw = new PrintWriter(new FileWriter(archivoVentas, false))) {
            for (var pedido : historialPedidos) {
                pw.printf("#PEDIDO|%d%n", pedido.getIdPedido());
                var prods = pedido.getProductos();
                var cants = pedido.getCantidades();
                for (int i = 0; i < prods.size(); i++) {
                    pw.printf("#ITEM|%s|%d%n", prods.get(i).getId(), cants.get(i));
                }
            }
        } catch (IOException e) {
            System.err.println("Error al guardar ventas: " + e.getMessage());
        }
    }
}